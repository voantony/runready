# Opens a merge request or pull request from a finished proof.
# The token stays on the server. Without it, the report still offers a patch download.
GITHUB_TOKEN=
GITLAB_TOKEN=

# auto | docker | unshare
# auto uses Docker when `docker info` succeeds, otherwise the unshare sandbox.
RUNREADY_SANDBOX=auto

# Optional overrides
# RUNREADY_DATA_DIR=./data
# RUNREADY_DOCKER_IMAGE=node:22-bookworm
# RUNREADY_COMMAND_TIMEOUT_MS=180000
# RUNREADY_CLONE_TIMEOUT_MS=120000
# RUNREADY_MAX_LOG_BYTES=200000
# RUNREADY_KEEP_WORKSPACE=1
